FROM golang:1.27.3-bookworm AS build
WORKDIR /src
COPY engine/go.mod engine/go.sum ./
RUN go mod download
COPY engine/ ./
RUN CGO_ENABLED=1 go build -trimpath -ldflags='-s -w' -o /messenger-service ./cmd/messenger-service

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* && mkdir /data && chown 10001:10001 /data
COPY --from=build /messenger-service /usr/local/bin/messenger-service
USER 10001:10001
VOLUME /data
EXPOSE 8787
ENTRYPOINT ["messenger-service"]
CMD ["--data-dir", "/data", "--listen", "0.0.0.0:8787"]
